# Database — TiDB Serverless (MySQL-compatible)
# Buat cluster di https://tidbcloud.com, dapatkan connection string-nya
# Format: mysql://<USER>.root:<PASS>@<HOST>.tidbcloud.com:4000/<DB>?sslaccept=strict
DATABASE_URL="mysql://user.root:password@host.tidbcloud.com:4000/pasarlokal?sslaccept=strict"

# Session (JWT) — generate string acak minimal 32 karakter
# Contoh: openssl rand -hex 32
SESSION_SECRET="generate-me-a-random-secret-at-least-32-chars-long"

# Vercel Blob — untuk upload gambar produk
# Buat Blob store di https://vercel.com/storage/blob → copy token-nya ke sini
BLOB_READ_WRITE_TOKEN=""
